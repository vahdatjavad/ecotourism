glowworms_daily <- glowworms |>
group_by(ws_id, date) |>
summarise(occurrence = n(), .groups = "drop")
weather_sub <- weather_data |>
select(ws_id, date, prcp)
summary(weather_sub)
summary(glowworms_daily)
weather_sub <- weather_data |>
filter(ws_id %in% c(glowworms_daily$ws_id)) |>
select(ws_id, date, prcp)
weather_sub |> count(ws_id)
summary(weather_sub)
data("tourism_quarterly")
force(tourism_quarterly)
library(lubridate)
glowworms_quarterly <- glowworms |>
mutate(quarter = quarter(date))
glowworms_quarterly <- glowworms |>
mutate(quarter = quarter(date)) |>
group_by(quarter) |>
summarise(occurrence = n(), .groups = "drop")
glowworms_quarterly <- glowworms |>
mutate(quarter = quarter(date)) |>
group_by(year, quarter) |>
summarise(occurrence = n(), .groups = "drop")
tourism_sub <- tourism_quarterly |>
mutate(year = year(quarter),
quarter = quarter(quarter))
tourism_sub <- tourism_quarterly |>
mutate(year = year(quarter),
quarter = quarter(quarter)) |>
select(year, quarter, purpose, trips, region_id)
#
data("tourism_region")
force(tourism_region)
tourism_region_sub <- tourism_region |>
filter(ws_id %in% glowworms$ws_id)
tourism_region_sub |> count(ws_id)
glowworms |> count(ws_id)
tourism_sub <- tourism_quarterly |>
filter(region_id %in% tourism_region_sub) |>
mutate(year = year(quarter),
quarter = quarter(quarter)) |>
select(year, quarter, purpose, trips, region_id)
tourism_sub <- tourism_quarterly |>
filter(region_id %in% tourism_region_sub)
tourism_quarterly |> count(region_id)
tourism_sub <- tourism_quarterly |>
filter(region_id %in% tourism_region_sub$region_id)
tourism_sub <- tourism_quarterly |>
filter(region_id %in% tourism_region_sub$region_id) |>
mutate(year = year(quarter),
quarter = quarter(quarter)) |>
select(year, quarter, purpose, trips, region_id)
glowworms_quarterly <- glowworms |>
mutate(quarter = quarter(date)) |>
group_by(year, quarter, ws_id) |>
summarise(occurrence = n(), .groups = "drop")
glowworms_regions <- glowworms_quarterly |>
left_join(tourism_sub, by="region_id")
glowworms_regions <- glowworms_quarterly |>
left_join(tourism_sub, by="ws_id")
glowworms_regions <- glowworms_quarterly |>
left_join(tourism_region_sub, by="ws_id")
glowworms_tourism <- glowworms_regions |>
left_join(tourism_sub, by=c("ws_id", "year", "quarter"))
glowworms_tourism <- glowworms_regions |>
left_join(tourism_sub, by=c("region_id", "year", "quarter"))
ggplot(glowworms_tourism, aes(x = quarter, y = occurrence)) +
geom_point()
library(ggbeeswarm)
ggplot(glowworms_tourism, aes(x = quarter, y = occurrence)) +
geom_quasirandom()
?geom_quasirandom
ggplot(glowworms_tourism, aes(x = quarter, y = occurrence)) +
geom_beeswarm()
ggplot(glowworms_tourism, aes(x = quarter, y = occurrence)) +
geom_jitter()
ggplot(glowworms_tourism, aes(x = quarter, y = occurrence)) +
geom_jitter(width=0.5)
ggplot(glowworms_tourism, aes(x = quarter, y = occurrence)) +
geom_jitter(width=0.1)
ggplot(glowworms_tourism, aes(x = quarter, y = occurrence)) +
geom_jitter(width=0.1) +
stat_summary(colour="red")
?stat_summary
ggplot(glowworms_tourism, aes(x = quarter, y = occurrence)) +
geom_jitter(width=0.1) +
stat_summary(colour="red", se=FALSE)
ggplot(glowworms_tourism, aes(x = quarter, y = occurrence)) +
geom_jitter(width=0.1) +
stat_summary(colour="red", geom = "point")
ggplot(glowworms_tourism, aes(x = quarter, y = occurrence)) +
geom_jitter(width=0.1) +
stat_summary(colour="red", geom = "point", size=5) +
labs(
title = "Relationship between tourism and glowworms occurrence",
x = "Quarter",
y = "Occurrence (jittered)"
) +
theme_minimal()
View(tourism_quarterly)
pkgdown::build_site()
