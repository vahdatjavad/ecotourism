library(ecotourism)
library(dplyr)
library(ecotourism)
data("glowworms")
glowworms |> glimpse()
library(ggplot2)
library(ggthemes)
glowworms |>
ggplot() +
geom_sf(data = oz_lga) +
geom_point(aes(x = obs_lon, y = obs_lat), color = "red") +
theme_map()
week_order <- c("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")
glowworms |>
ggplot(aes(x = factor(weekday, levels = week_order))) +
geom_bar() +
labs(x = "Weekday", y = "Number of Records") +
theme_minimal()
glowworms |>
dplyr::mutate(month = lubridate::month(month, label = TRUE, abbr = TRUE)) |>
ggplot(aes(x = factor(month, levels = month.name))) +
geom_bar() +
labs(x = "Month", y = "Number of Records")
glowworms |>
dplyr::mutate(month = lubridate::month(month, label = TRUE, abbr = TRUE)) |>
ggplot(aes(x = factor(month, levels = month.name))) +
geom_bar()
glowworms |>
dplyr::mutate(month = lubridate::month(month, label = TRUE, abbr = TRUE)) |>
ggplot(aes(x = factor(month))) +
geom_bar() +
labs(x = "Month", y = "Number of Records")
glowworms |>
ggplot(aes(x = factor(year))) +
geom_bar() +
labs(x = "Year", y = "Number of Records")
library(dplyr)
library(ggplot2)
library(ecotourism)
# Prepare glowworms occurrence counts per day
glowworms_daily <- glowworms %>%
group_by(ws_id, date) %>%
summarise(occurrence = n(), .groups = "drop")
glowworms_weather <- glowworms_daily %>%
left_join(weather_data %>% select(ws_id, date, prcp),
by = c("ws_id", "date"))
ggplot(glowworms_weather, aes(x = prcp, y = occurrence)) +
geom_point(alpha = 0.6) +
labs(
title = "Relationship between Precipitation and glowworms Occurrence",
x = "Precipitation (mm)",
y = "Number of glowworms Records"
) +
theme_minimal()
